<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Picall</AssemblyName>
    <RootNamespace>Picall</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.2.5</Version>
    <Company>Picall</Company>
    <Product>Picall</Product>
    <Description>Fast local photo and video library for Windows.</Description>
    <ApplicationIcon>Assets\picall.ico</ApplicationIcon>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Installer\**\*.cs" />
    <Compile Remove="tools\CodecProbe\**\*.cs" />
    <PackageReference Include="Magick.NET-Q8-x64" Version="14.15.0" />
  </ItemGroup>
</Project>
