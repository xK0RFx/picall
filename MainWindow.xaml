<Window x:Class="Picall.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Picall"
        xmlns:controls="clr-namespace:Picall.Controls"
        xmlns:models="clr-namespace:Picall.Models"
        Title="Picall" Width="1280" Height="800" MinWidth="900" MinHeight="580"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}"
        Loaded="Window_Loaded" Closing="Window_Closing" StateChanged="Window_StateChanged"
        PreviewKeyDown="Window_PreviewKeyDown">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0" ResizeBorderThickness="7" CornerRadius="0" GlassFrameThickness="0"/>
  </WindowChrome.WindowChrome>

  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    <Style x:Key="CaptionButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
      <Setter Property="Width" Value="46"/>
      <Setter Property="Height" Value="47"/>
      <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Root" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="#242932"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Opacity" Value="0.65"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="NavButton" TargetType="RadioButton">
      <Setter Property="Height" Value="44"/>
      <Setter Property="Margin" Value="10,2"/>
      <Setter Property="Padding" Value="13,0"/>
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Root" Background="Transparent" CornerRadius="10" Padding="{TemplateBinding Padding}">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="Icon" Text="{TemplateBinding Tag}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center"/>
                <ContentPresenter Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0"/>
                <TextBlock x:Name="Count" Grid.Column="2" Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=ToolTip}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="#171B21"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/></Trigger>
              <Trigger Property="IsChecked" Value="True"><Setter TargetName="Root" Property="Background" Value="#292139"/><Setter Property="Foreground" Value="#C4B5FD"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SourceButton" TargetType="RadioButton">
      <Setter Property="Height" Value="42"/>
      <Setter Property="Margin" Value="10,1"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Root" Background="Transparent" CornerRadius="9" Padding="{TemplateBinding Padding}">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="{TemplateBinding Tag}" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="5,0,6,0">
                  <ContentPresenter/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding CountLabel}" FontSize="10" Foreground="#747E8C" VerticalAlignment="Center"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="#171B21"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/></Trigger>
              <Trigger Property="IsChecked" Value="True"><Setter TargetName="Root" Property="Background" Value="#24202F"/><Setter Property="Foreground" Value="#C4B5FD"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="FilterChip" TargetType="ToggleButton">
      <Setter Property="Height" Value="30"/>
      <Setter Property="Margin" Value="0,0,6,7"/>
      <Setter Property="Padding" Value="10,0"/>
      <Setter Property="Background" Value="#20252D"/>
      <Setter Property="Foreground" Value="#AAB2BF"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="#2D343E"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Chip" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chip" Property="BorderBrush" Value="#66558A"/></Trigger>
              <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chip" Property="Background" Value="#352A49"/><Setter TargetName="Chip" Property="BorderBrush" Value="#7157A7"/><Setter Property="Foreground" Value="#D8CCFA"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ContextMenu">
      <Setter Property="Background" Value="#1B1F26"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="BorderBrush" Value="#343B46"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="5"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ContextMenu">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
              <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="MenuItem">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Padding" Value="11,7"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="MenuItem">
            <Border x:Name="MenuRoot" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
              <ContentPresenter ContentSource="Header"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="MenuRoot" Property="Background" Value="#2A3039"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
      <Setter Property="Height" Value="11"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Separator"><Grid Width="132" Background="Transparent"><Border Background="#3B424D" Height="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" SnapsToDevicePixels="True"/></Grid></ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style x:Key="VerticalScrollThumb" TargetType="Thumb">
      <Setter Property="MinHeight" Value="36"/>
      <Setter Property="Margin" Value="3,2"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Border x:Name="ThumbBody" Background="#56606E" CornerRadius="3"/>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbBody" Property="Background" Value="#7D6BA7"/></Trigger>
              <Trigger Property="IsDragging" Value="True"><Setter TargetName="ThumbBody" Property="Background" Value="#9B7CF2"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="HorizontalScrollThumb" TargetType="Thumb" BasedOn="{StaticResource VerticalScrollThumb}">
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="MinWidth" Value="36"/>
      <Setter Property="Margin" Value="2,3"/>
    </Style>

    <Style TargetType="ScrollBar">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Width" Value="12"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Border Background="#14181E" CornerRadius="6" Margin="1">
              <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Focusable="False">
                    <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template>
                  </RepeatButton>
                </Track.DecreaseRepeatButton>
                <Track.Thumb><Thumb Style="{StaticResource VerticalScrollThumb}"/></Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Focusable="False">
                    <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template>
                  </RepeatButton>
                </Track.IncreaseRepeatButton>
              </Track>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Width" Value="Auto"/>
          <Setter Property="Height" Value="12"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ScrollBar">
                <Border Background="#14181E" CornerRadius="6" Margin="1">
                  <Track x:Name="PART_Track" IsDirectionReversed="False" Orientation="Horizontal">
                    <Track.DecreaseRepeatButton>
                      <RepeatButton Command="{x:Static ScrollBar.PageLeftCommand}" Focusable="False">
                        <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template>
                      </RepeatButton>
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb><Thumb Style="{StaticResource HorizontalScrollThumb}"/></Track.Thumb>
                    <Track.IncreaseRepeatButton>
                      <RepeatButton Command="{x:Static ScrollBar.PageRightCommand}" Focusable="False">
                        <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template>
                      </RepeatButton>
                    </Track.IncreaseRepeatButton>
                  </Track>
                </Border>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="SliderThumb" TargetType="Thumb">
      <Setter Property="Width" Value="16"/>
      <Setter Property="Height" Value="16"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Grid Width="16" Height="16" ClipToBounds="False">
              <Ellipse x:Name="ThumbGlow" Fill="#332A48" Width="16" Height="16"/>
              <Ellipse x:Name="ThumbCore" Fill="#A78BFA" Width="12" Height="12"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbGlow" Property="Fill" Value="#554272"/><Setter TargetName="ThumbCore" Property="Fill" Value="#C4B5FD"/></Trigger>
              <Trigger Property="IsDragging" Value="True"><Setter TargetName="ThumbGlow" Property="Fill" Value="#7157A7"/><Setter TargetName="ThumbCore" Property="Fill" Value="White"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="DarkSlider" TargetType="Slider">
      <Setter Property="Height" Value="28"/>
      <Setter Property="MinHeight" Value="28"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Grid ClipToBounds="False" Background="Transparent">
              <Track x:Name="PART_Track" Height="24" VerticalAlignment="Center"
                     Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Focusable="False">
                    <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="4" Background="#8B5CF6" CornerRadius="2" VerticalAlignment="Center"/></ControlTemplate></RepeatButton.Template>
                  </RepeatButton>
                </Track.DecreaseRepeatButton>
                <Track.Thumb><Thumb Style="{StaticResource SliderThumb}"/></Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Focusable="False">
                    <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="4" Background="#303640" CornerRadius="2" VerticalAlignment="Center"/></ControlTemplate></RepeatButton.Template>
                  </RepeatButton>
                </Track.IncreaseRepeatButton>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="DarkCombo" TargetType="ComboBox">
      <Setter Property="Height" Value="42"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="ItemContainerStyle" Value="{DynamicResource DarkComboItem}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="11">
                <Grid>
                  <ContentPresenter Margin="13,0,34,0" VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                  <TextBlock Text="&#xE70D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,13,0"/>
                </Grid>
              </Border>
              <ToggleButton Background="Transparent" BorderThickness="0" Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"/></ControlTemplate></ToggleButton.Template>
              </ToggleButton>
              <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                <Border Background="#1A1E25" BorderBrush="#343B46" BorderThickness="1" CornerRadius="10" Padding="4" Margin="0,5,0,0" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                  <ScrollViewer MaxHeight="340"><StackPanel IsItemsHost="True"/></ScrollViewer>
                </Border>
              </Popup>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="DarkComboItem" TargetType="ComboBoxItem">
      <Setter Property="Height" Value="36"/>
      <Setter Property="Padding" Value="10,0"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="ItemRoot" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemRoot" Property="Background" Value="#292F39"/></Trigger>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemRoot" Property="Background" Value="#352A49"/><Setter Property="Foreground" Value="#C4B5FD"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="GalleryItem" TargetType="ListBoxItem">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="VerticalContentAlignment" Value="Stretch"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Grid Background="Transparent"><ContentPresenter/></Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border x:Name="WindowBorder" BorderBrush="#303640" BorderThickness="1" Background="{StaticResource WindowBrush}" CornerRadius="12">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="49"/><RowDefinition Height="*"/></Grid.RowDefinitions>

      <Border Grid.Row="0" Background="#0D1014" BorderBrush="#303640" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <Grid Margin="16,0,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border Width="27" Height="27" CornerRadius="8" Background="{StaticResource AccentBrush}">
              <Grid>
                <Ellipse Width="12" Height="12" Fill="White" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5"/>
                <Ellipse Width="7" Height="7" Fill="#D8B4FE" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="5"/>
              </Grid>
            </Border>
            <TextBlock Text="picall" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,1"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <Button Style="{StaticResource CaptionButton}" Click="Minimize_Click">
              <Path Data="M 0,5 L 10,5" Stroke="#DDE2EA" StrokeThickness="1.2" Width="10" Height="10" Stretch="None"/>
            </Button>
            <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Click="Maximize_Click">
              <Path x:Name="MaximizeGlyph" Data="M 0.7,0.7 L 9.3,0.7 9.3,9.3 0.7,9.3 Z" Stroke="#DDE2EA" StrokeThickness="1.15" Fill="Transparent" Width="10" Height="10" Stretch="Fill"/>
            </Button>
            <Button Style="{StaticResource CaptionButton}" Click="Close_Click">
              <Button.Template>
                <ControlTemplate TargetType="Button">
                  <Border x:Name="Root" Background="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="#C42B1C"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Background" Value="#A92317"/></Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Button.Template>
              <Path Data="M 0,0 L 10,10 M 10,0 L 0,10" Stroke="#F3F5F8" StrokeThickness="1.2" Width="10" Height="10" Stretch="None"/>
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions><ColumnDefinition Width="232"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#0E1115" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Margin="0,20,0,0">
              <TextBlock Text="МЕДИАТЕКА" Foreground="#68717E" FontSize="10" FontWeight="Bold" Margin="23,0,0,8"/>
              <RadioButton x:Name="AllFilter" GroupName="MediaFilter" Style="{StaticResource NavButton}" Content="Всё медиа" Tag="&#xE8A9;" IsChecked="True" Click="Filter_Click" ToolTip="{Binding AllCount}"/>
              <RadioButton x:Name="PhotoFilter" GroupName="MediaFilter" Style="{StaticResource NavButton}" Content="Фотографии" Tag="&#xEB9F;" Click="Filter_Click" ToolTip="{Binding PhotoCount}"/>
              <RadioButton x:Name="VideoFilter" GroupName="MediaFilter" Style="{StaticResource NavButton}" Content="Видео" Tag="&#xE8B2;" Click="Filter_Click" ToolTip="{Binding VideoCount}"/>
              <RadioButton x:Name="FavoriteFilter" GroupName="MediaFilter" Style="{StaticResource NavButton}" Content="Избранное" Tag="&#xE734;" Click="Filter_Click" ToolTip="{Binding FavoriteCount}"/>
            </StackPanel>

            <Grid Grid.Row="1" Grid.RowSpan="2" Margin="0,24,0,8">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <Grid Margin="23,0,16,8">
                <TextBlock Text="ИСТОЧНИКИ" Foreground="#68717E" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                <Button HorizontalAlignment="Right" Width="26" Height="26" Style="{StaticResource IconButton}" ToolTip="Добавить папку" Click="AddFolder_Click">
                  <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"/>
                </Button>
              </Grid>
              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Sources}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:SourceOption}">
                      <RadioButton GroupName="SourceFilter" Style="{StaticResource SourceButton}" Content="{Binding Name}" Tag="{Binding IconGlyph}" IsChecked="{Binding IsSelected, Mode=TwoWay}" ToolTip="{Binding Subtitle}" Click="SourceFilter_Click"/>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Grid>

            <Border Grid.Row="3" Margin="14" Padding="12" CornerRadius="12" Background="#15191F" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Grid Width="22" Height="22" VerticalAlignment="Center">
                  <Ellipse x:Name="ScanPulse" Fill="#2C2540"/>
                  <Ellipse Width="7" Height="7" Fill="{StaticResource AccentLightBrush}"/>
                </Grid>
                <StackPanel Grid.Column="1" Margin="5,0,7,0" VerticalAlignment="Center">
                  <TextBlock x:Name="ScanStateText" Text="Подготовка…" FontSize="11" FontWeight="SemiBold"/>
                  <TextBlock x:Name="ScanDetailText" Text="Читаю индекс" FontSize="9" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Button Grid.Column="2" x:Name="ScanButton" Style="{StaticResource IconButton}" Width="30" Height="30" ToolTip="Обновить индекс" Click="ScanButton_Click">
                  <TextBlock x:Name="ScanButtonIcon" Text="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"/>
                </Button>
              </Grid>
            </Border>
          </Grid>
        </Border>

        <Grid Grid.Column="1">
          <Grid.RowDefinitions><RowDefinition Height="104"/><RowDefinition Height="*"/><RowDefinition Height="44"/></Grid.RowDefinitions>
          <Grid Grid.Row="0" Margin="30,20,30,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="320"/><ColumnDefinition Width="12"/><ColumnDefinition Width="150"/><ColumnDefinition Width="10"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock x:Name="SectionTitle" Text="Всё медиа" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="25" FontWeight="SemiBold"/>
              <TextBlock x:Name="ResultCountText" Text="Загрузка медиатеки…" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="1,3,0,0"/>
            </StackPanel>
            <Border Grid.Column="1" Height="44" Background="{StaticResource SurfaceRaisedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" VerticalAlignment="Center">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
                <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Grid Grid.Column="1">
                  <TextBox x:Name="SearchBox" Background="Transparent" Foreground="{StaticResource TextBrush}" BorderThickness="0" FontSize="13" VerticalContentAlignment="Center" CaretBrush="White" TextChanged="SearchBox_TextChanged"/>
                  <TextBlock x:Name="SearchPlaceholder" Text="Имя файла или папка" Foreground="#707987" FontSize="13" VerticalAlignment="Center" IsHitTestVisible="False"/>
                </Grid>
                <Button x:Name="ClearSearchButton" Grid.Column="2" Style="{StaticResource IconButton}" Width="30" Height="30" Visibility="Collapsed" Click="ClearSearch_Click">
                  <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"/>
                </Button>
              </Grid>
            </Border>
            <ComboBox x:Name="SortCombo" Grid.Column="3" Style="{StaticResource DarkCombo}" SelectedIndex="0" SelectionChanged="SortCombo_SelectionChanged">
              <ComboBoxItem Content="Сначала новые" Tag="newest"/>
              <ComboBoxItem Content="Сначала старые" Tag="oldest"/>
              <ComboBoxItem Content="По имени" Tag="name"/>
              <ComboBoxItem Content="По размеру" Tag="size"/>
            </ComboBox>
            <ToggleButton x:Name="FilterButton" Grid.Column="5" Width="44" Height="44" Style="{StaticResource FilterChip}" Margin="0" ToolTip="Фильтры">
              <Grid>
                <Path Data="M 1,1 L 15,1 10,7 10,13 6,15 6,7 Z" Stroke="#C9D0DA" StrokeThickness="1.2" Fill="Transparent" Width="16" Height="16" Stretch="Fill"/>
                <Border x:Name="FilterBadge" Background="{StaticResource AccentBrush}" CornerRadius="7" MinWidth="14" Height="14" Padding="3,0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-7,-7,0" Visibility="Collapsed">
                  <TextBlock x:Name="FilterBadgeText" Text="1" FontSize="8" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
              </Grid>
            </ToggleButton>
            <Popup x:Name="FilterPopup" Grid.Column="5" PlacementTarget="{Binding ElementName=FilterButton}" Placement="Bottom" HorizontalOffset="-306" VerticalOffset="8" AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade" IsOpen="{Binding IsChecked, ElementName=FilterButton, Mode=TwoWay}" DataContext="{Binding DataContext, ElementName=FilterButton}">
              <Border Width="350" MaxHeight="600" Background="#171B21" BorderBrush="#343B46" BorderThickness="1" CornerRadius="14" Padding="18">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <StackPanel>
                    <Grid Margin="0,0,0,17">
                      <TextBlock Text="Фильтры" FontSize="17" FontWeight="SemiBold"/>
                      <Button HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Foreground="#A78BFA" Content="Сбросить" Cursor="Hand" FontSize="11" Click="ResetFilters_Click"/>
                    </Grid>
                    <TextBlock Text="ДАТА ИЗМЕНЕНИЯ" Foreground="#747E8C" FontSize="9" FontWeight="Bold" Margin="0,0,0,7"/>
                    <ComboBox x:Name="DateFilterCombo" Style="{StaticResource DarkCombo}" SelectedIndex="0" Margin="0,0,0,16" SelectionChanged="AdvancedFilter_SelectionChanged">
                      <ComboBoxItem Content="За всё время" Tag="any"/>
                      <ComboBoxItem Content="Последние 7 дней" Tag="7d"/>
                      <ComboBoxItem Content="Последние 30 дней" Tag="30d"/>
                      <ComboBoxItem Content="Последний год" Tag="year"/>
                    </ComboBox>
                    <TextBlock Text="РАЗМЕР ФАЙЛА" Foreground="#747E8C" FontSize="9" FontWeight="Bold" Margin="0,0,0,7"/>
                    <ComboBox x:Name="SizeFilterCombo" Style="{StaticResource DarkCombo}" SelectedIndex="0" Margin="0,0,0,16" SelectionChanged="AdvancedFilter_SelectionChanged">
                      <ComboBoxItem Content="Любой размер" Tag="any"/>
                      <ComboBoxItem Content="До 1 МБ" Tag="small"/>
                      <ComboBoxItem Content="От 1 до 10 МБ" Tag="medium"/>
                      <ComboBoxItem Content="От 10 до 100 МБ" Tag="large"/>
                      <ComboBoxItem Content="Больше 100 МБ" Tag="huge"/>
                    </ComboBox>
                    <Grid Margin="0,0,0,9">
                      <TextBlock Text="ФОРМАТЫ" Foreground="#747E8C" FontSize="9" FontWeight="Bold" VerticalAlignment="Center"/>
                      <Button HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Foreground="#A78BFA" Content="Выбрать все" Cursor="Hand" FontSize="10" Click="SelectAllFormats_Click"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding FormatFilters}">
                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:FormatFilterOption}">
                          <ToggleButton Style="{StaticResource FilterChip}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Click="FormatFilter_Click" ToolTip="{Binding CountLabel}">
                            <StackPanel Orientation="Horizontal">
                              <TextBlock Text="{Binding Label}" FontSize="10" FontWeight="SemiBold"/>
                              <TextBlock Text="{Binding CountLabel}" FontSize="9" Foreground="#9AA3B0" Margin="6,0,0,0"/>
                            </StackPanel>
                          </ToggleButton>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ToggleButton x:Name="UnavailableFormatsToggle" Style="{StaticResource FilterChip}" Margin="0,4,0,8" HorizontalAlignment="Left">
                      <TextBlock FontSize="10">
                        <Run Text="Другие форматы · "/><Run Text="{Binding UnavailableFormatCount, Mode=OneWay}"/>
                      </TextBlock>
                    </ToggleButton>
                    <ItemsControl ItemsSource="{Binding UnavailableFormatFilters}" Visibility="{Binding IsChecked, ElementName=UnavailableFormatsToggle, Converter={StaticResource BoolToVisibility}}">
                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:FormatFilterOption}">
                          <ToggleButton Style="{StaticResource FilterChip}" IsChecked="False" IsEnabled="False" Opacity="0.52" ToolTip="Файлов этого формата не найдено">
                            <TextBlock Text="{Binding Label}" FontSize="10" FontWeight="SemiBold"/>
                          </ToggleButton>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>

          <Grid Grid.Row="1">
            <ListBox x:Name="GalleryList" ItemsSource="{Binding DisplayedItems}" Background="Transparent" BorderThickness="0"
                     ItemContainerStyle="{StaticResource GalleryItem}" SelectionMode="Single"
                     ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     ScrollViewer.ScrollChanged="GalleryScrollChanged"
                     SelectionChanged="GalleryList_SelectionChanged">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <controls:VirtualizingWrapPanel ItemWidth="{Binding TileWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  ItemHeight="{Binding TileHeight, RelativeSource={RelativeSource AncestorType=Window}}"/>
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type models:MediaItem}">
                  <Border x:Name="Card" Margin="8" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14"
                          Loaded="MediaCard_Loaded" Unloaded="MediaCard_Unloaded" MouseLeftButtonDown="MediaCard_MouseLeftButtonDown">
                    <Border.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="Открыть" Click="OpenMenu_Click"/>
                        <MenuItem Header="Показать в Проводнике" Click="RevealMenu_Click"/>
                        <Separator/>
                        <MenuItem Header="В избранное / убрать" Click="FavoriteMenu_Click"/>
                        <MenuItem Header="Копировать путь" Click="CopyPathMenu_Click"/>
                      </ContextMenu>
                    </Border.ContextMenu>
                    <Grid ClipToBounds="True">
                      <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="58"/></Grid.RowDefinitions>
                      <Border x:Name="Preview" CornerRadius="13,13,8,8" Background="#171B21" Margin="3,3,3,0" ClipToBounds="True">
                        <Grid>
                          <TextBlock x:Name="PlaceholderIcon" Text="&#xEB9F;" FontFamily="Segoe MDL2 Assets" FontSize="30" Foreground="#3D4653" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                          <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="Fant" SnapsToDevicePixels="True"/>
                          <Border x:Name="VideoPill" Background="#B0000000" CornerRadius="7" Padding="7,4" Margin="9" HorizontalAlignment="Left" VerticalAlignment="Bottom" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                              <TextBlock Text="&#xE768;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" VerticalAlignment="Center"/>
                              <TextBlock Text=" VIDEO" FontSize="9" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                          </Border>
                          <Button x:Name="FavoriteButton" Style="{StaticResource IconButton}" Width="32" Height="32" Margin="7" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#9A111318" Click="FavoriteButton_Click" Visibility="Collapsed">
                            <TextBlock x:Name="FavoriteGlyph" Text="&#xE735;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"/>
                          </Button>
                        </Grid>
                      </Border>
                      <Grid Grid.Row="1" Margin="12,0,10,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                          <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                          <TextBlock Text="{Binding DateLabel}" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="#20252D" CornerRadius="5" Padding="6,3" VerticalAlignment="Center">
                          <TextBlock Text="{Binding ExtensionLabel}" FontSize="9" FontWeight="Bold" Foreground="#AAB2BF"/>
                        </Border>
                      </Grid>
                    </Grid>
                  </Border>
                  <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Thumbnail}" Value="{x:Null}">
                      <Setter TargetName="PlaceholderIcon" Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:MediaKind.Video}">
                      <Setter TargetName="VideoPill" Property="Visibility" Value="Visible"/>
                      <Setter TargetName="PlaceholderIcon" Property="Text" Value="&#xE8B2;"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                      <Setter TargetName="FavoriteButton" Property="Visibility" Value="Visible"/>
                      <Setter TargetName="FavoriteGlyph" Property="Text" Value="&#xE735;"/>
                      <Setter TargetName="FavoriteGlyph" Property="Foreground" Value="#FBBF24"/>
                    </DataTrigger>
                    <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                      <Setter TargetName="Card" Property="BorderBrush" Value="#6D5A9A"/>
                      <Setter TargetName="FavoriteButton" Property="Visibility" Value="Visible"/>
                    </Trigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <Button x:Name="PendingRefreshButton" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,12,0,0"
                    Padding="14,8" Background="#E9282D35" BorderBrush="#6D5A9A" BorderThickness="1"
                    Foreground="#F5F2FF" FontSize="11" FontWeight="SemiBold" Cursor="Hand" Visibility="Collapsed" Panel.ZIndex="20"
                    Click="PendingRefreshButton_Click" ToolTip="Обновить сетку и перейти к началу">
              <Button.Template>
                <ControlTemplate TargetType="Button">
                  <Border x:Name="PendingBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="16" Padding="{TemplateBinding Padding}">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Margin="0,0,7,0" VerticalAlignment="Center"/>
                      <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="PendingBorder" Property="Background" Value="#F13A3347"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="PendingBorder" Property="Background" Value="#FF4A3C61"/></Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Button.Template>
            </Button>

            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False">
              <Border Width="72" Height="72" CornerRadius="24" Background="#171B21" Margin="0,0,0,18">
                <TextBlock x:Name="EmptyIcon" Text="&#xE8A9;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="29" Foreground="#596270" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <TextBlock x:Name="EmptyTitle" Text="Здесь пока пусто" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
              <TextBlock x:Name="EmptySubtitle" Text="Picall найдёт фото и видео автоматически" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,7,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
          </Grid>

          <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Background="#0E1115">
            <Grid Margin="24,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock x:Name="FooterText" Text="Локальная медиатека · данные не покидают компьютер" Foreground="#68717E" FontSize="10" VerticalAlignment="Center"/>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="&#xE8A9;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="#7B8491" FontSize="12" VerticalAlignment="Center"/>
                <Slider x:Name="ZoomSlider" Style="{StaticResource DarkSlider}" Minimum="152" Maximum="264" Value="194" Width="94" Margin="8,0" IsSnapToTickEnabled="True" TickFrequency="14" ValueChanged="ZoomSlider_ValueChanged"/>
                <TextBlock Text="&#xE8A9;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="#AAB2BF" FontSize="16" VerticalAlignment="Center"/>
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
